{{>layouts/header}}
<link rel="stylesheet" href="../css/runLog.css">
<div class="container-main">
    <div class="title">RUN LOG</div>
    <form action="/runLog/update" method="post">
        <div class="log-container">
            <div class="log-content">
                <table class="log-table">
                    <thead class="table-header">
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Date (YYYY-MM-DD)</th>
                        <th scope="col">Distance (km)</th>
                        <th scope="col">Duration (min)</th>

                    </tr>
                    </thead>
                    <tbody class="table-body">
                    {{#runLog}}
                        <tr>
                            <td><input type="text" name="run_title" class="log-details" placeholder="Enter Run Title" value="{{run_title}}"></td>
                            <td><input type="text" name="run_date" class="log-details" placeholder="Enter Run Date" value="{{run_date}}"></td>
                            <td><input type="text" name="run_distance" class="log-details" placeholder="Enter Run Distance" value="{{run_distance}}"></td>
                            <td><input type="text" name="run_duration" class="log-details" placeholder="Enter Run Duration" value="{{run_duration}}"></td>

                        </tr>
                    {{/runLog}}
                    </tbody>
                    <thead class="table-header">
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Avg HR (bpm)</th>
                        <th scope="col">Avg Pace (min/km)</th>
                        <th scope="col">Notes ('-' if no note)</th>
                    </tr>
                    </thead>
                    <tbody class="table-body">
                    {{#runLog}}
                        <tr>
                            <td><input type="text" name="run_type" class="log-details" placeholder="Enter Run Type" value="{{run_type}}"></td>
                            <td><input type="text" name="avg_hr" class="log-details" placeholder="Enter Avg. HR" value="{{avg_hr}}"></td>
                            <td><input type="text" name="avg_pace" class="log-details" placeholder="Enter Avg. Pace" value="{{avg_pace}}"></td>
                            <td><input type="text" name="notes" class="log-details" placeholder="Enter Notes" value="{{notes}}"></td>
                            <input type="hidden" name="log_id" value="{{log_id}}">
                            <input type="hidden" name="user_id" value="{{user_id}}">
                        </tr>
                    {{/runLog}}
                    </tbody>
                </table>
            </div>
            <div class="button-container">
                <!--<button class="edit-run-btn" onclick="window.location.href='/runLog/edit'">EDIT RUN</button>-->
                <button class="cancel-run-btn" onclick="window.location.href='/runLog'">CANCEL</button>
                <button class="add-run-btn" type="submit">EDIT RUN</button>
            </div>
        </div>
    </form>
</div>
{{>layouts/footer}}