{{>layouts/header}}
<link rel="stylesheet" href="../css/pbTracker.css">
<div class="container-main">
    <div class="title">EDIT YOUR PR</div>
    <form action="/pbTracker/update" method="post">
        <div class="pb-container">
            {{#pbTracker}}
                <div class="pb-horizontal-container">
                    {{#this}}
                        <div class="pb-entry">
                            <div class="category">{{category}}</div>
                            <input type="text" name="timingList" class="pb-details" placeholder="Enter Timing" value="{{timing}}" pattern="^\d{2}:\d{2}:\d{2}$" required>
                            <input type="text" name="raceEventList" class="pb-details" placeholder="Enter Race Event" value="{{race_event}}">
                            <input type="text" name="raceDateList" class="pb-details" placeholder="Enter Race Date" value="{{race_date}}">
                            <input type="hidden" name="idList" value="{{pb_id}}">
                        </div>
                    {{/this}}
                </div>
            {{/pbTracker}}
            <div class="button-container">
                <button class="edit-timing-btn" type="submit">SUBMIT</button>
            </div>
        </div>
    </form>
</div>
<script>
    document.querySelector("form").addEventListener("submit", function (e) {
        const inputs = document.querySelectorAll("input[name='timingList']");
        const regex = /^\d{2}:\d{2}:\d{2}$/;

        for (const input of inputs) {
            if (!regex.test(input.value)) {
                alert("Please enter time in HH:mm:ss format (e.g., 01:30:45)");
                input.focus();
                e.preventDefault();
                return false;
            }
        }
    });
</script>
{{>layouts/footer}}